# Copy to /etc/preecursor/acquisition.env, root-owned 0600. Never commit real values.
ACQ_DATABASE=/var/lib/preecursor-acquisition/leads.sqlite3
ACQ_PUBLIC_URL=https://preecursor.com/acquisition
ACQ_ORIGINS=https://preecursor.com,https://www.preecursor.com
ACQ_TOKEN_SECRET=
ACQ_TURNSTILE_SECRET=
ACQ_BOOKING_URL=
ACQ_CALENDLY_SECRET=
ACQ_CALENDLY_EVENT_TYPE=
ACQ_CRM_ENABLED=false
ACQ_HUBSPOT_TOKEN=
ACQ_SENDING_ENABLED=false
ACQ_RESEND_TOKEN=
ACQ_RESEND_WEBHOOK_SECRET=
ACQ_SENDER=
ACQ_REPLY_TO=
ACQ_POSTAL_ADDRESS=
