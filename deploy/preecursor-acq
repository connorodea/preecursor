#!/usr/bin/env python3
"""Install root-owned at /usr/local/sbin/preecursor-acq; invoke with sudo.

systemd loads the root-only environment file without printing or shell-parsing secrets.
"""
import os
import sys

if os.geteuid() != 0:
    raise SystemExit('Run this operator command with sudo')
os.execvp('systemd-run', [
    'systemd-run', '--quiet', '--wait', '--pipe', '--collect',
    '--property=User=preecursor-acq', '--property=Group=preecursor-acq',
    '--property=EnvironmentFile=/etc/preecursor/acquisition.env',
    '--property=WorkingDirectory=/opt/preecursor-acquisition/current',
    '--property=UMask=0077', '--property=Environment=PYTHONDONTWRITEBYTECODE=1',
    '/opt/preecursor-acquisition/venv/bin/python', '-m', 'services.acquisition.cli', *sys.argv[1:],
])
